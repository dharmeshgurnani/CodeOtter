    "pr": {
      "number": 482,
      "title": "Add rate limiting to telemetry ingest",
      "body": "Adds a token-bucket limiter in front of POST /ingest so a misbehaving fleet cannot starve the others.\n\nKeyed per fleet, window and burst configurable via INGEST_WINDOW_MS and INGEST_BURST. Internal collectors bypass the limiter.\n\nTests cover refill, burst and the bypass path.",
      "url": "https://github.com/acme-robotics/fleet-api/pull/482",
      "author": {
        "login": "dharmeshgurnani"
      },
      "baseRefName": "main",
