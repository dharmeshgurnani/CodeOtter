{
  "name": "codeotter",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": "dharmeshgurnani/CodeOtter",
  "homepage": "https://codeotter.io",
  "description": "CodeOtter — Dual-engine AI code review scores, blast radius analysis, and merge gates from any open model, self-hosted.",
  "bin": {
    "codeotter": "./tui/codeotter.ts"
  },
  "scripts": {
    "cli": "node tui/codeotter.ts",
    "tui": "node tui/codeotter.ts tui",
    "build:tui-icon": "node tui/build-icon.ts",
    "dev": "node bin/dev.ts",
    "start": "node core/server.ts",
    "co:start": "sh bin/start.sh",
    "co:install": "bash bin/install.sh",
    "test:forgejo": "node test/integration/forges.test.ts",
    "test:gitea": "node test/integration/forges.test.ts --gitea",
    "build": "pnpm -C web install && pnpm -C web build",
    "test": "tsc -p . && node --test \"test/*.test.ts\" && pnpm -C web test",
    "test:core": "node --test \"test/*.test.ts\"",
    "test:watch": "node --test --watch \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"core/**\" --test-coverage-include=\"tui/**\" \"test/*.test.ts\"",
    "test:e2e": "pnpm -C web test:e2e",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "ansi-regex": "^6.4.0",
    "blessed": "0.1.81",
    "hono": "4.13.17",
    "slice-ansi": "^9.0.1",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
