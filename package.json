{
  "name": "codeotter",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": "dharmeshgurnani/CodeOtter",
  "homepage": "https://codeotter.io",
  "description": "CodeOtter — Dual-engine AI code review scores, blast radius analysis, and merge gates from any open model, self-hosted.",
  "bin": {
    "codeotter": "./tui/codeotter.mjs"
  },
  "scripts": {
    "cli": "node tui/codeotter.mjs",
    "tui": "node tui/codeotter.mjs tui",
    "build:tui-icon": "node tui/build-icon.mjs",
    "dev": "node bin/dev.mjs",
    "start": "node core/server.mjs",
    "co:start": "sh bin/start.sh",
    "co:install": "bash bin/install.sh",
    "test:forgejo": "node test/integration/forges.test.mjs",
    "test:gitea": "node test/integration/forges.test.mjs --gitea",
    "build": "pnpm -C web install && pnpm -C web build",
    "test": "node --test \"test/*.test.mjs\" && pnpm -C web test",
    "test:core": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"core/**\" --test-coverage-include=\"tui/**\" \"test/*.test.mjs\"",
    "test:e2e": "pnpm -C web test:e2e"
  },
  "dependencies": {
    "ansi-regex": "^6.4.0",
    "blessed": "0.1.81",
    "slice-ansi": "^9.0.1",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
