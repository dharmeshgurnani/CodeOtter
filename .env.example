# GitHub: a token with repo read access; gh uses it inside the container
GH_TOKEN=ghp_...
# Optional Forgejo connection, alongside GitHub. Admin -> Forgejo overrides these.
# FORGEJO_URL=https://forgejo.example.com
# FORGEJO_TOKEN=...
# Forgejo OAuth client ID/secret are configured separately in Admin -> OAuth.
# Optional: seeds the first repository; otherwise add repositories under Settings → Repositories
# REPO=owner/name
# Optional: treat anonymous visitors as owner (lock-out recovery). Unset it again afterwards.
# PR_SCORER_RECOVERY=1

# Model defaults. Optional: the Settings page in the app overrides these and persists to PocketBase.
LLM_API_KEY=...
LLM_MODEL=MiniMax-M3
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# Local models (Settings → Local models) live in PR_SCORER_DATA (default .local/). S1_DEVICE / LLM_DEVICE=cpu force CPU.
# PR_SCORER_DATA=/app/pb_data/local
# CodeReviewer needs Python 3.10+; point at one if it is not on PATH.
# PR_SCORER_PYTHON=/usr/bin/python3.12

# PocketBase superuser (also the login for the admin UI on :8090/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please
# Public address of this app, used for the GitHub OAuth callback (default http://localhost:4747)
# APP_URL=https://pr-scorer.example.com
